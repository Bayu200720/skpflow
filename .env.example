# Supabase (project Settings -> Database)
# Runtime: transaction pooler port 6543, user postgres.<project-ref>
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migrasi/introspeksi: session pooler port 5432 (direct host IPv6-only)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

AUTH_SECRET="replace-with-32-plus-random-characters"
AUTH_URL="http://localhost:3000"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_FORCE_PATH_STYLE="false"
# Wajib jika STORAGE_DRIVER="supabase" (bucket privat, server-side)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"
MAX_UPLOAD_MB="10"
APP_TIMEZONE="Asia/Jakarta"
